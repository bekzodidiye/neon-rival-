# GEMINI_API_KEY: Optional server-side key (not required for Neon Rivals gameplay)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted
APP_URL="MY_APP_URL"

# VITE_GAME_SERVER_WS_URL: Optional dedicated WebSocket server URL when frontend is hosted separately (e.g. wss://game.example.com/ws)
VITE_GAME_SERVER_WS_URL=""

# VITE_API_BASE_URL: Optional dedicated API base URL when backend is hosted separately (e.g. https://game.example.com)
VITE_API_BASE_URL=""
